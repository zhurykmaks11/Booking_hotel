{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "npx --yes oxlint@1 -c oxlint.json --deny-warnings src test",
    "lint:ci": "npx --yes oxlint@1 -c oxlint.json --deny-warnings --format=github src test",
    "test": "node --no-experimental-webstorage node_modules/jest/bin/jest.js",
    "test:watch": "node --no-experimental-webstorage node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --no-experimental-webstorage node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --no-experimental-webstorage node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "benchmark:dist": "node scripts/benchmark.js distribution",
    "benchmark:failover": "node scripts/benchmark.js failover",
    "benchmark:asymmetric": "node scripts/benchmark.js asymmetric",
    "lb:switch": "node scripts/benchmark.js switch",
    "benchmark:cache": "node scripts/benchmark.js cache",
    "load:all": "powershell -ExecutionPolicy Bypass -File load-tests/run-load-tests.ps1 -Experiment all -ApplyLimits",
    "load:baseline": "powershell -ExecutionPolicy Bypass -File load-tests/run-load-tests.ps1 -Experiment baseline",
    "load:scaling": "powershell -ExecutionPolicy Bypass -File load-tests/run-load-tests.ps1 -Experiment scaling",
    "load:caching": "powershell -ExecutionPolicy Bypass -File load-tests/run-load-tests.ps1 -Experiment caching",
    "load:demo": "powershell -ExecutionPolicy Bypass -File load-tests/run-load-tests.ps1 -Experiment single -Scenario a -Hold 20",
    "load:report": "node load-tests/report.js",
    "load:replication": "powershell -ExecutionPolicy Bypass -File load-tests/run-load-tests.ps1 -Experiment replication -ApplyLimits",
    "repl:status": "node scripts/replication-demo.js status",
    "repl:replicate": "node scripts/replication-demo.js replicate",
    "repl:lag": "node scripts/replication-demo.js lag",
    "repl:stale": "node scripts/replication-demo.js stale",
    "repl:failover-replica": "node scripts/replication-demo.js failover-replica",
    "repl:failover-primary": "node scripts/replication-demo.js failover-primary"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
